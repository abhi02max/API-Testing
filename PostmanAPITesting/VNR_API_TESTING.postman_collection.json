    {
      "name": "TestScriptsGenerationUsingPostman",
      "item": [
        {
          "name": "FakeStore - POST Script",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status Code is 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Status Code\", () => {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response Time\", () => {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Successful POST request\", function () {\r",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 202]);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Status Code Validation\", function () {\r",
                  "    pm.response.to.have.status(\r",
                  "        parseInt(pm.iterationData.get(\"expectedStatus\"))\r",
                  "    );\r",
                  "});\r",
                  "\r",
                  "let jsonData = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Token exists\", function () {\r",
                  "\r",
                  "    if(pm.response.code==200){\r",
                  "\r",
                  "        pm.expect(jsonData.token).to.not.be.null;\r",
                  "\r",
                  "    }\r",
                  "\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Status Code Validation\", function () {\r",
                  "    pm.response.to.have.status(parseInt(pm.iterationData.get(\"status\")));\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response Time\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"id\": 0,\r\n    \"title\": \"{{title}}\",\r\n    \"price\": {{price}},\r\n    \"description\": \"{{description}}\",\r\n    \"category\": \"{{category}}\",\r\n    \"image\": \"https://fakestoreapi.com/img/81fPKd-2AYL._AC_SL1500_t.png\"\r\n}"
            },
